# config.env.example 을 config.env 로 복사해 값을 채우세요 (config.env 는 git 에 올리지 않음)
# 값에 공백·따옴표를 넣지 말 것. 줄바꿈은 LF 유지
# AWS 대상 인스턴스
INSTANCE_ID=i-xxxxxxxxxxxxxxxxx
IMAGE_ID=ami-xxxxxxxxxxxxxxxxx
# 메일 (msmtp 계정명, 발신/수신 주소; MAIL_CC 는 쉼표로 구분)
MSMTP_ACCOUNT=my-account
MAIL_FROM=sender@example.com
MAIL_FROM_NAME=Company
ALERT_TO=admin@example.com
MAIL_TO=customer@example.com
MAIL_CC=cc1@example.com,cc2@example.com
TEST_MAIL_TO=test@example.com
# 메일 본문 인사말
COMPANY_NAME=회사명
SENDER_NAME=홍길동
# 서명 HTML 경로 (생략 시 스크립트와 같은 폴더의 mail-sign.html, 예시: ltee-일일인프라점검/mail-sign.example.html)
# MAIL_SIGN_FILE=/path/to/mail-sign.html
